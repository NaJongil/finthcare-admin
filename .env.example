# Vercel > Settings > Environment Variables 에 등록한다.
# Production과 Preview 양쪽에 걸어야 한다 — 한쪽만 걸면 그쪽 배포에서만 동작한다.
#
# 값을 추가·수정한 뒤에는 반드시 재배포해야 반영된다.
# Vercel은 배포 시점의 환경변수를 스냅샷으로 굳히기 때문에,
# 변수만 추가하고 기존 배포를 그대로 두면 계속 누락 상태로 동작한다.
#
# 누락 시 /api/auth, /api/report는 503과
# '서버 설정이 완료되지 않았습니다' 를 반환하고, 어떤 변수가 빠졌는지는
# Vercel 런타임 로그에 남는다.

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appTUSvRn9GseZXVk

# 세션 토큰 서명 키. openssl rand -base64 32 로 생성한다.
SESSION_SECRET=
